# Database Configuration
DB_TYPE=postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexus_admin

# Server Configuration
PORT=4000
CORS_ORIGINS=http://localhost:3000

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_TWO_FACTOR_SECRET=your-2fa-secret-here

# JWT Expiration
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_TWO_FACTOR_EXPIRES_IN=5m

# OTP Configuration
OTP_EXPIRES_IN_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30

# Seed Data
AUTO_SEED=true
ADMIN_EMAIL=admin@nexus.dev
ADMIN_PASSWORD=Admin123!
DEFAULT_TENANT_NAME=Nexus HQ
DEFAULT_TENANT_SLUG=nexus
DEMO_TENANT_NAME=Acme Corp
DEMO_TENANT_SLUG=acme

# Audit Log Retention (days, 0 = forever)
AUDIT_LOG_RETENTION_DAYS=90

# Redis Configuration (for GPS telemetry stream)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
